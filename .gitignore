# Создайте .gitignore с типичным содержимым для C++/VS проекта:
echo "# Visual Studio
.vs/
.vscode/
*.vcxproj.user
*.sln.user
*.suo
*.user
*.userosscache

# Build files
build/
Debug/
Release/
x64/
x86/
*.exe
*.dll
*.lib
*.pdb
*.obj
*.ilk
*.log
*.idb
*.pch

# System files
Thumbs.db
.DS_Store

# Large files
*.zip
*.rar
*.7z
*.tar
*.gz" > .gitignore