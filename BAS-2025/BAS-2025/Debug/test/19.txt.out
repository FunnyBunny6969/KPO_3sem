main { \declare uint num ; \num = 5 ; \switch ( 0x07 | num ) \{ \case 0x01 : \num = num + 10 ; \switch ( 0x07 | num ) \{ \case 0x01 : break ; \case 'C' : break ; \default : break ; \} ; \break ; \\case 0x02 : break ; \} ; \return 2 ; \} ; 
